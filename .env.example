PORT=3001
ENV=dev
DB_TYPE=sql
CORS_ORIGINS=http://localhost:3005,http://localhost:3000
FRONTEND_URL=http://localhost:3005
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-another-long-random-secret

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Alias supported by this app if you copied the secret key from Supabase's new API keys page:
# SUPABASE_SECRET_KEY=your-secret-key
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:your-password@aws-0-region.pooler.supabase.com:6543/postgres
# Alias supported by this app:
# SUPABASE_POSTGRES_URL=postgresql://postgres.your-project-ref:your-password@aws-0-region.pooler.supabase.com:6543/postgres
SUPABASE_DB_SSL=true
MONGODB_URI=mongodb://localhost:27017/jhatkabyte
SUPABASE_STORAGE_BUCKET=jb-bucket
SUPABASE_STORAGE_PUBLIC=true

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password
ADMIN_NAME=JhatkaByte Admin
ADMIN_PHONE=9999999999

EMAIL_USERNAME=jhatkabyte@gmail.com
EMAIL_PASSWORD=
EMAIL_FROM=jhatkabyte@gmail.com

# Render production example:
# ENV=prod
# FRONTEND_URL=https://your-vercel-app.vercel.app
# CORS_ORIGINS=https://your-vercel-app.vercel.app
